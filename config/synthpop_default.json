{
  "schema": "synthpop-config-1",
  "_comment": "EXPERIMENTAL synthetic-population assumptions. Nothing here is calibrated to census, employment or commuting data. All weights/caps/radii are tunable placeholders; see docs/synthetic_population.md.",
  "n_agents": 100000,
  "seed": 42,
  "residential": {
    "include_tiers": ["A", "B"],
    "tier_factor": {"A": 1.0, "B": 1.0, "C": 1.0},
    "area_floor_m2": 20.0,
    "area_cap_m2": 500.0,
    "alpha": 1.0,
    "use_levels": false,
    "levels_cap": 10,
    "max_agents_per_home": 25
  },
  "destinations": {
    "include_categories": ["education", "healthcare", "industrial", "office", "commercial_retail", "civic_public", "leisure"],
    "category_weight": {"education": 1.0, "healthcare": 1.0, "industrial": 1.0, "office": 1.0, "commercial_retail": 1.0,
                        "civic_public": 1.0, "leisure": 1.0, "worship": 1.0, "other_amenity": 1.0},
    "leisure_values": ["park", "garden", "sports_centre", "stadium", "swimming_pool", "fitness_centre", "playground", "recreation_ground"],
    "area_floor_m2": 50.0,
    "area_cap_m2": 5000.0,
    "alpha": 0.5,
    "poi_default_area_m2": 100.0,
    "min_capacity": 3,
    "capacity_slack": 3.0,
    "max_share_of_population": 0.005
  },
  "dedup": {
    "name_merge_radius_m": 50.0,
    "log_radius_m": 10.0,
    "merge_unnamed_same_category_within_m": 0.0,
    "layer_priority": ["healthcare", "amenities", "leisure", "buildings"]
  },
  "assignment": {
    "kernel": {"type": "exponential", "scale_m": 5000.0, "power_exponent": 2.0, "power_min_distance_m": 100.0},
    "candidate_k": 30,
    "radius_m": 15000.0,
    "fallback_radius_multipliers": [2.0, 4.0],
    "max_rounds": 200,
    "fail_on_unassigned": true
  },
  "sensitivity": {"enabled": true, "capacity_slack": [1.5, 2.0, 3.0, 5.0, 10.0, 1000000000.0]},
  "audit_reference": {"tier_A": 24130, "tier_B": 182348, "tier_C": 606807},
  "vocab": {
    "res_explicit": ["apartments", "bungalow", "detached", "dormitory", "duplex", "house", "houses", "residential", "semidetached_house", "terrace", "villa"],
    "edu_amenity": ["childcare", "college", "driving_school", "kindergarten", "language_school", "music_school", "research_institute", "school", "training", "university"],
    "edu_building": ["college", "kindergarten", "school", "university"],
    "health_amenity": ["clinic", "dentist", "doctors", "hospital", "nursing_home", "pharmacy", "veterinary"],
    "health_building": ["clinic", "hospital"],
    "ind_building": ["factory", "industrial", "manufacture", "storage_tank", "warehouse"],
    "office_building": ["office"],
    "office_amenity": ["coworking_space"],
    "com_building": ["commercial", "kiosk", "mall", "retail", "shop", "supermarket"],
    "retail_amenity": ["atm", "bank", "bar", "bureau_de_change", "cafe", "car_rental", "car_wash", "cinema", "fast_food", "food_court", "fuel", "marketplace", "pub", "restaurant", "theatre"],
    "civic_amenity": ["bus_station", "community_centre", "courthouse", "fire_station", "government", "library", "police", "post_office", "public_building", "townhall"],
    "civic_building": ["civic", "government", "public", "train_station", "transportation"],
    "worship_building": ["chapel", "church", "mosque", "religious", "shrine", "synagogue", "temple"],
    "act_tag_cols": ["amenity", "shop", "office", "healthcare", "craft", "tourism", "leisure"],
    "category_order": ["education", "healthcare", "industrial", "office", "commercial_retail", "civic_public", "worship", "leisure", "other_amenity"]
  }
}
